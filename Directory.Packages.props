<Project>
  <PropertyGroup>
    <!-- Central package management: every version is pinned here, exactly. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="App">
    <!-- Spectre.Console is pre-1.0 and Spectre.Console.Cli is versioned separately: pin both. -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>
</Project>
